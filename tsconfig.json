{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "isolatedDeclarations": true,
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2020",
    "types": ["node"],
    "useUnknownInCatchVariables": false,
    "verbatimModuleSyntax": true
  },
  "exclude": ["dist/", "./src/fixtures/", "**/*.test.ts"],
  "include": ["./src/**/*"]
}
