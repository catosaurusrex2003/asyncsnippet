{
  "name": "asyncsnippet",
  "version": "0.1.0",
  "description": "Code snippet generator for asynchronous protocol operations, using an AsyncAPI operation as the source of truth (WebSocket only for now)",
  "keywords": [
    "async",
    "asyncapi",
    "codegen",
    "event-driven",
    "snippet",
    "websocket",
    "ws"
  ],
  "homepage": "https://github.com/catosaurusrex2003/asyncsnippet",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/catosaurusrex2003/asyncsnippet.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist/",
    "format": "npx oxlint --fix && npx oxfmt --write",
    "lint": "npx oxlint && npx oxfmt --check && tsc",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "dev": "unrun scripts/dev.ts",
    "dev:gallery": "unrun scripts/gallery.ts"
  },
  "dependencies": {
    "type-fest": "^5.5.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/node-fetch": "^2.6.13",
    "@types/ws": "^8.5.13",
    "@vitest/ui": "^4.1.10",
    "js-yaml": "^4.1.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.2",
    "unrun": "^0.3.1",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=22"
  }
}
