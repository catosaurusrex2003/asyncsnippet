exports[`fixtures (snapshot) — rust/tokio-tungstenite > simple.yaml — send-only, no bindings 1`] = `
"use futures_util::{SinkExt, StreamExt};
use tokio_tungstenite::{connect_async, tungstenite::Message};


#[tokio::main]
async fn main() {
    let url = "wss://ping.example.com/ping";

    let (ws_stream, _) = connect_async(url).await.expect("Failed to connect");
    let (mut write, mut read) = ws_stream.split();

    let payload = serde_json::json!({
      "timestamp": 1735689600
    });

    write
        .send(Message::Text(payload.to_string().into()))
        .await
        .expect("Failed to send message");

    if let Some(msg) = read.next().await {
        println!("{}", msg.expect("Failed to read message"));
    }
}"
`;

exports[`fixtures (snapshot) — rust/tokio-tungstenite > with-bindings.yaml — query param and header both resolve 1`] = `
"use futures_util::{SinkExt, StreamExt};
use tokio_tungstenite::{connect_async, tungstenite::client::IntoClientRequest, tungstenite::Message};


#[tokio::main]
async fn main() {
    let url = "wss://chat.example.com/rooms/general?token=abc123token";

    let mut request = url.into_client_request().expect("Invalid URL");
    request
        .headers_mut()
        .insert("X-Client-Version", "1.0".parse().expect("Invalid header value"));

    let (ws_stream, _) = connect_async(request).await.expect("Failed to connect");
    let (mut write, mut read) = ws_stream.split();

    let payload = serde_json::json!({
      "text": "hello world",
      "from": "alice"
    });

    write
        .send(Message::Text(payload.to_string().into()))
        .await
        .expect("Failed to send message");

    if let Some(msg) = read.next().await {
        println!("{}", msg.expect("Failed to read message"));
    }
}"
`;

exports[`fixtures (snapshot) — schema-generated examples > schema-generated.yaml — kafka-secure server, no explicit bindings or examples, resolves entirely from protocol derivation + schema generation 1`] = `
"// NOTE: some values could not be resolved from the AsyncAPI document's
// default/examples and were filled with a placeholder — replace them
// with real values before running this snippet:
//   - message payload (no explicit example — generated from its schema)
//   - kafka clientId
//   - kafka consumer group id

import { Kafka } from 'kafkajs';

const kafka = new Kafka({
  clientId: '<kafka clientId>',
  brokers: ['broker.example.com:9092'],
});

const consumer = kafka.consumer({ groupId: '<kafka consumer group id>' });

// Example message shape for this operation:
// {
//   "lumens": 0,
//   "sentAt": "2024-01-01T00:00:00Z",
//   "tags": [
//     "string"
//   ],
//   "status": "on"
// }

async function main() {
  await consumer.connect();
  await consumer.subscribe({ topic: 'lighting.measured', fromBeginning: true });

  await consumer.run({
    eachMessage: async ({ message }) => {
      console.log(message.value?.toString());
    },
  });
}

main();"
`;

