"// NOTE: some values could not be resolved from the AsyncAPI document's
// default/examples and were filled with a placeholder — replace them
// with real values before running this snippet:
//   - query param "region"

package main

import (
	"log"

	"github.com/gorilla/websocket"
)

func main() {
	url := "wss://alerts.example.com/alerts?region=%3Cregion%3E"

	conn, _, err := websocket.DefaultDialer.Dial(url, nil)
	if err != nil {
		log.Fatal("dial:", err)
	}
	defer conn.Close()

	// Example message shape for this operation ("sampleAlert"):
	// {
	//   "severity": "high",
	//   "message": "disk usage above threshold"
	// }

	for {
		_, message, err := conn.ReadMessage()
		if err != nil {
			log.Println("read:", err)
			return
		}
		log.Println(string(message))
	}
}"
`;

exports[`fixtures (snapshot) — go/gorilla > simple.yaml — send-only, no bindings 1`] = `
"package main

import (
	"encoding/json"
	"log"

	"github.com/gorilla/websocket"
)

func main() {
	url := "wss://ping.example.com/ping"

	conn, _, err := websocket.DefaultDialer.Dial(url, nil)
	if err != nil {
		log.Fatal("dial:", err)
	}
	defer conn.Close()

	payload := map[string]interface{}{
		"timestamp": 1735689600,
	}

	data, err := json.Marshal(payload)
	if err != nil {
		log.Fatal("marshal:", err)
	}
	if err := conn.WriteMessage(websocket.TextMessage, data); err != nil {
		log.Fatal("write:", err)
	}

	_, message, err := conn.ReadMessage()
	if err != nil {
		log.Fatal("read:", err)
	}
	log.Println(string(message))
}"
`;

exports[`fixtures (snapshot) — go/gorilla > with-bindings.yaml — query param and header both resolve 1`] = `
"package main

import (
	"encoding/json"
	"log"
	"net/http"

	"github.com/gorilla/websocket"
)

func main() {
	url := "wss://chat.example.com/rooms/general?token=abc123token"

	header := http.Header{}
	header.Set("X-Client-Version", "1.0")

	conn, _, err := websocket.DefaultDialer.Dial(url, header)
	if err != nil {
		log.Fatal("dial:", err)
	}
	defer conn.Close()

	payload := map[string]interface{}{
		"text": "hello world",
		"from": "alice",
	}

	data, err := json.Marshal(payload)
	if err != nil {
		log.Fatal("marshal:", err)
	}
	if err := conn.WriteMessage(websocket.TextMessage, data); err != nil {
		log.Fatal("write:", err)
	}

	_, message, err := conn.ReadMessage()
	if err != nil {
		log.Fatal("read:", err)
	}
	log.Println(string(message))
}"
`;

