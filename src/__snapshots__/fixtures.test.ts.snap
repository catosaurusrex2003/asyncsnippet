exports[`fixtures (snapshot) — python/confluent-kafka > kafka.yaml — receive operation subscribes and polls, without producing 1`] = `
"import json

from confluent_kafka import Consumer


consumer = Consumer({
    "bootstrap.servers": "broker1.example.com:9092,broker2.example.com:9092",
    "group.id": "order-processing-service",
    "client.id": "order-service-consumer",
    "auto.offset.reset": "earliest",
})

# Example message shape for this operation ("sampleOrderCreated"):
# {
#   "orderId": "order-42",
#   "total": 59.99
# }

consumer.subscribe(["order.events.v1"])

try:
    while True:
        msg = consumer.poll(1.0)
        if msg is None:
            continue
        if msg.error():
            print(msg.error())
            continue
        print(msg.value().decode('utf-8'))
finally:
    consumer.close()"
`;

exports[`fixtures (snapshot) — python/confluent-kafka > kafka.yaml — send operation resolves the topic override and message key 1`] = `
"import json

from confluent_kafka import Producer


producer = Producer({
    "bootstrap.servers": "broker1.example.com:9092,broker2.example.com:9092",
    "client.id": "order-service-producer",
})

payload = json.dumps({
    "orderId": "order-42",
    "total": 59.99,
})

producer.produce(
    "order.events.v1",
    value=payload.encode('utf-8'),
    key="order-42",
)
producer.flush()"
`;

