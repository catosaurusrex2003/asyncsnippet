// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`fixtures (snapshot) > multi-message.yaml — operation with multiple messages uses the first message 1`] = `
"import WebSocket from 'ws';

const socket = new WebSocket('wss://trading.example.com/orders');

socket.on('open', () => {
  socket.send(JSON.stringify({
    "symbol": "ACME",
    "quantity": 10
  }));
});

socket.on('message', (data) => {
  console.log(data.toString());
});"
`;

