exports[`fixtures (snapshot) — rust/rdkafka > kafka.yaml — receive operation subscribes and streams, without producing 1`] = `
"use rdkafka::config::ClientConfig;
use rdkafka::consumer::{Consumer, StreamConsumer};
use rdkafka::Message;
use futures_util::StreamExt;


// Example message shape for this operation ("sampleOrderCreated"):
// {
//   "orderId": "order-42",
//   "total": 59.99
// }

#[tokio::main]
async fn main() {
    let consumer: StreamConsumer = ClientConfig::new()
        .set("bootstrap.servers", "broker1.example.com:9092,broker2.example.com:9092")
        .set("group.id", "order-processing-service")
        .set("client.id", "order-service-consumer")
        .set("auto.offset.reset", "earliest")
        .create()
        .expect("Failed to create consumer");

    consumer.subscribe(&["order.events.v1"]).expect("Failed to subscribe");

    let mut stream = consumer.stream();
    while let Some(message) = stream.next().await {
        let message = message.expect("Failed to read message");
        if let Some(payload) = message.payload_view::<str>().and_then(Result::ok) {
            println!("{}", payload);
        }
    }
}"
`;

