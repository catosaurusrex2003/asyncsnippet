exports[`fixtures (snapshot) — python/websockets > simple.yaml — send-only, no bindings 1`] = `
"import asyncio
import json

import websockets


async def main() -> None:
    async with websockets.connect("wss://ping.example.com/ping") as websocket:

        await websocket.send(
            json.dumps({
                "timestamp": 1735689600,
            })
        )

        message = await websocket.recv()
        print(message)


asyncio.run(main())"
`;

exports[`fixtures (snapshot) — python/websockets > with-bindings.yaml — query param and header both resolve 1`] = `
"import asyncio
import json

import websockets


async def main() -> None:
    async with websockets.connect(
        "wss://chat.example.com/rooms/general?token=abc123token",
        additional_headers={
            "X-Client-Version": "1.0",
        },
    ) as websocket:

        await websocket.send(
            json.dumps({
                "text": "hello world",
                "from": "alice",
            })
        )

        message = await websocket.recv()
        print(message)


asyncio.run(main())"
`;

exports[`fixtures (snapshot) — rust/tokio-tungstenite > pubsub.yaml — receive-only operation loops over read without sending 1`] = `
"// NOTE: some values could not be resolved from the AsyncAPI document's
// default/examples and were filled with a placeholder — replace them
// with real values before running this snippet:
//   - query param "region"

use futures_util::{SinkExt, StreamExt};
use tokio_tungstenite::{connect_async, tungstenite::Message};


#[tokio::main]
async fn main() {
    let url = "wss://alerts.example.com/alerts?region=%3Cregion%3E";

    let (ws_stream, _) = connect_async(url).await.expect("Failed to connect");
    let (_write, mut read) = ws_stream.split();

    // Example message shape for this operation ("sampleAlert"):
    // {
    //   "severity": "high",
    //   "message": "disk usage above threshold"
    // }

    while let Some(msg) = read.next().await {
        println!("{}", msg.expect("Failed to read message"));
    }
}"
`;

exports[`fixtures (snapshot) — rust/tokio-tungstenite > simple.yaml — send-only, no bindings 1`] = `
"use futures_util::{SinkExt, StreamExt};
use tokio_tungstenite::{connect_async, tungstenite::Message};


#[tokio::main]
async fn main() {
    let url = "wss://ping.example.com/ping";

    let (ws_stream, _) = connect_async(url).await.expect("Failed to connect");
    let (mut write, mut read) = ws_stream.split();

    let payload = serde_json::json!({
      "timestamp": 1735689600
    });

    write
        .send(Message::Text(payload.to_string().into()))
        .await
        .expect("Failed to send message");

    if let Some(msg) = read.next().await {
        println!("{}", msg.expect("Failed to read message"));
    }
}"
`;

exports[`fixtures (snapshot) — rust/tokio-tungstenite > with-bindings.yaml — query param and header both resolve 1`] = `
"use futures_util::{SinkExt, StreamExt};
use tokio_tungstenite::{connect_async, tungstenite::client::IntoClientRequest, tungstenite::Message};


#[tokio::main]
async fn main() {
    let url = "wss://chat.example.com/rooms/general?token=abc123token";

    let mut request = url.into_client_request().expect("Invalid URL");
    request
        .headers_mut()
        .insert("X-Client-Version", "1.0".parse().expect("Invalid header value"));

    let (ws_stream, _) = connect_async(request).await.expect("Failed to connect");
    let (mut write, mut read) = ws_stream.split();

    let payload = serde_json::json!({
      "text": "hello world",
      "from": "alice"
    });

    write
        .send(Message::Text(payload.to_string().into()))
        .await
        .expect("Failed to send message");

    if let Some(msg) = read.next().await {
        println!("{}", msg.expect("Failed to read message"));
    }
}"
`;
