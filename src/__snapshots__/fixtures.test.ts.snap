exports[`fixtures (snapshot) — go/gorilla > pubsub.yaml — receive-only operation loops over ReadMessage without writing 1`] = `
"// NOTE: some values could not be resolved from the AsyncAPI document's
// default/examples and were filled with a placeholder — replace them
// with real values before running this snippet:
//   - query param "region"

package main

import (
	"log"

	"github.com/gorilla/websocket"
)

func main() {
	url := "wss://alerts.example.com/alerts?region=%3Cregion%3E"

	conn, _, err := websocket.DefaultDialer.Dial(url, nil)
	if err != nil {
		log.Fatal("dial:", err)
	}
	defer conn.Close()

	// Example message shape for this operation ("sampleAlert"):
	// {
	//   "severity": "high",
	//   "message": "disk usage above threshold"
	// }

	for {
		_, message, err := conn.ReadMessage()
		if err != nil {
			log.Println("read:", err)
			return
		}
		log.Println(string(message))
	}
}"
`;

exports[`fixtures (snapshot) — go/gorilla > simple.yaml — send-only, no bindings 1`] = `
"package main

import (
	"encoding/json"
	"log"

	"github.com/gorilla/websocket"
)

func main() {
	url := "wss://ping.example.com/ping"

	conn, _, err := websocket.DefaultDialer.Dial(url, nil)
	if err != nil {
		log.Fatal("dial:", err)
	}
	defer conn.Close()

	payload := map[string]interface{}{
		"timestamp": 1735689600,
	}

	data, err := json.Marshal(payload)
	if err != nil {
		log.Fatal("marshal:", err)
	}
	if err := conn.WriteMessage(websocket.TextMessage, data); err != nil {
		log.Fatal("write:", err)
	}

	_, message, err := conn.ReadMessage()
	if err != nil {
		log.Fatal("read:", err)
	}
	log.Println(string(message))
}"
`;

exports[`fixtures (snapshot) — go/gorilla > with-bindings.yaml — query param and header both resolve 1`] = `
"package main

import (
	"encoding/json"
	"log"
	"net/http"

	"github.com/gorilla/websocket"
)

func main() {
	url := "wss://chat.example.com/rooms/general?token=abc123token"

	header := http.Header{}
	header.Set("X-Client-Version", "1.0")

	conn, _, err := websocket.DefaultDialer.Dial(url, header)
	if err != nil {
		log.Fatal("dial:", err)
	}
	defer conn.Close()

	payload := map[string]interface{}{
		"text": "hello world",
		"from": "alice",
	}

	data, err := json.Marshal(payload)
	if err != nil {
		log.Fatal("marshal:", err)
	}
	if err := conn.WriteMessage(websocket.TextMessage, data); err != nil {
		log.Fatal("write:", err)
	}

	_, message, err := conn.ReadMessage()
	if err != nil {
		log.Fatal("read:", err)
	}
	log.Println(string(message))
}"
`;

exports[`fixtures (snapshot) — javascript/kafkajs > kafka.yaml — receive operation subscribes and consumes, without sending 1`] = `
"import { Kafka } from 'kafkajs';

const kafka = new Kafka({
  clientId: 'order-service-consumer',
  brokers: ['broker1.example.com:9092', 'broker2.example.com:9092'],
});

const consumer = kafka.consumer({ groupId: 'order-processing-service' });

// Example message shape for this operation ("sampleOrderCreated"):
// {
//   "orderId": "order-42",
//   "total": 59.99
// }

async function main() {
  await consumer.connect();
  await consumer.subscribe({ topic: 'order.events.v1', fromBeginning: true });

  await consumer.run({
    eachMessage: async ({ message }) => {
      console.log(message.value?.toString());
    },
  });
}

main();"
`;

exports[`fixtures (snapshot) — javascript/kafkajs > kafka.yaml — send operation resolves the topic override and message key 1`] = `
"import { Kafka } from 'kafkajs';

const kafka = new Kafka({
  clientId: 'order-service-producer',
  brokers: ['broker1.example.com:9092', 'broker2.example.com:9092'],
});

const producer = kafka.producer();

async function main() {
  await producer.connect();
  await producer.send({
    topic: 'order.events.v1',
    messages: [
      {
        key: 'order-42',
        value: JSON.stringify({
          "orderId": "order-42",
          "total": 59.99
        }),
      },
    ],
  });
  await producer.disconnect();
}

main();"
`;

