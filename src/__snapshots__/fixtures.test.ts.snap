exports[`fixtures (snapshot) > pubsub.yaml — send operation 1`] = `
"import WebSocket from 'ws';

const socket = new WebSocket('wss://alerts.example.com/heartbeat');

socket.on('open', () => {
  socket.send(JSON.stringify({
    "ok": true
  }));
});

socket.on('message', (data) => {
  console.log(data.toString());
});"
`;

exports[`fixtures (snapshot) > simple.yaml — send-only, no bindings, no channel parameters 1`] = `
"import WebSocket from 'ws';

const socket = new WebSocket('wss://ping.example.com/ping');

socket.on('open', () => {
  socket.send(JSON.stringify({
    "timestamp": 1735689600
  }));
});

socket.on('message', (data) => {
  console.log(data.toString());
});"
`;

exports[`fixtures (snapshot) > with-bindings.yaml — query param, header, and channel parameter all resolve 1`] = `
"import WebSocket from 'ws';

const socket = new WebSocket('wss://chat.example.com/rooms/general?token=abc123token', {
  headers: {
    'X-Client-Version': '1.0'
  },
});

socket.on('open', () => {
  socket.send(JSON.stringify({
    "text": "hello world",
    "from": "alice"
  }));
});

socket.on('message', (data) => {
  console.log(data.toString());
});"
`;
